# ==============================================================================
# TrafficAnnotator AI Tuner Configuration
# ==============================================================================
# Do not commit your actual .env file with real API keys to version control!
# Copy this file to .env and configure your keys.

# OpenRouter API Key (Supports Gemini 2.0 Flash, GPT-4o, Claude 3.5 Sonnet, Qwen 2.5 VL, etc.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Alternative: OpenCode / Local Vision Server (OpenAI-compatible endpoint)
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=http://localhost:11434/v1
# OPENCODE_MODEL=

# Cloud annotation: copy to .env and launch the backend with --env-file .env.
# See docs/cloud-inference.md for deployment and a lightweight laptop install.
VISIONLAB_INFERENCE_BACKEND=local
# Full HTTPS URL of your VisionLab worker's /v1/infer endpoint:
VISIONLAB_CLOUD_URL=
# Same private bearer token as the worker's VISIONLAB_CLOUD_TOKEN:
VISIONLAB_CLOUD_TOKEN=
VISIONLAB_CLOUD_TIMEOUT=180
